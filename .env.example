# Copy this file to .env before running migrations:
#
#   cp .env.example .env
#
# .env is gitignored — keep real secrets out of version control.

# Postgres connection string.
# Matches the `db` service in docker-compose.yml, which publishes 5432.
#
# If you already run Postgres natively, it will own 5432 and migrations fail
# with "P1010: User was denied access". Publish the container on a free port in
# a docker-compose.override.yml and change the port here to match:
#
#   services:
#     db:
#       ports:
#         - "5433:5432"
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/expense_tracker?schema=public"

# Secret used to sign JWTs. Any long random string works for local development;
# generate one with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"
